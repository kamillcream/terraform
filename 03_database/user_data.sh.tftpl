#!/bin/bash
set -euo pipefail

DB_VOLUME_ID="${replace(volume_id, "-", "")}"
DB_NAME='${db_name}'
DB_USER='${db_user}'
DB_PASSWORD='${db_pass}'

${docker_install_script}
dnf install -y nvme-cli xfsprogs

# EBS may appear under an NVMe device name on current EC2 instance families.
for attempt in $(seq 1 60); do
  DB_DEVICE="$(lsblk -dn -o NAME,SERIAL | awk -v id="$DB_VOLUME_ID" '$2 == id {print "/dev/" $1}')"
  if [ -n "$DB_DEVICE" ]; then
    break
  fi
  sleep 5
done

if [ -z "$${DB_DEVICE:-}" ]; then
  echo "Could not find EBS volume $DB_VOLUME_ID" >&2
  exit 1
fi

if ! blkid "$DB_DEVICE" >/dev/null 2>&1; then
  mkfs -t ext4 "$DB_DEVICE"
fi

mkdir -p /var/lib/postgresql
DB_UUID="$(blkid -s UUID -o value "$DB_DEVICE")"
grep -q "$DB_UUID" /etc/fstab || echo "UUID=$DB_UUID /var/lib/postgresql ext4 defaults,nofail 0 2" >> /etc/fstab
mountpoint -q /var/lib/postgresql || mount /var/lib/postgresql

docker pull postgres:16
docker run -d --name postgres --restart unless-stopped -p 5432:5432 -e POSTGRES_DB="$DB_NAME" -e POSTGRES_USER="$DB_USER" -e POSTGRES_PASSWORD="$DB_PASSWORD" -v /var/lib/postgresql:/var/lib/postgresql/data postgres:16
